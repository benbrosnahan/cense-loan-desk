+/**
+ * A fixed plan's payment: each loan amortised over the term at its own rate,
+ * then added up. That is what repays every loan within the term (34 CFR
+ * 685.208(b)(1)(i) and (b)(4)(ii)). One payment at the blended rate is a
+ * little lower and leaves the high-rate loans owing when the term ends.
+ */
+export function levelPayment(loans: Loan[], years: number): number {
+  return loans.reduce(
+    (sum, l) => sum + amortizedPayment(l.balance, l.rate, years),
+    0
+  );
+}
+
+function fixedTotals(loans: Loan[], years: number) {
+  const monthly = levelPayment(loans, years);
   const totalPaid = monthly * years * 12;
   return {
     monthlyPayment: monthly,
     totalPaid,
-    totalInterest: Math.max(0, totalPaid - balance),
+    totalInterest: Math.max(0, totalPaid - totalBalance(loans)),
   };
 }
 
