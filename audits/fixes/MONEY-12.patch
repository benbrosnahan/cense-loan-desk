diff --git a/src/lib/storage.ts b/src/lib/storage.ts
index e41444f..a8f179f 100644
--- a/src/lib/storage.ts
+++ b/src/lib/storage.ts
@@ -36,7 +36,22 @@ function write(key: string, value: unknown): void {
 export const loanStore = {
   load: (): Loan[] | null => {
     const v = read<Loan[] | null>(LOANS_KEY, null);
-    return Array.isArray(v) ? v : null;
+    if (!Array.isArray(v)) return null;
+    // The loan form used to save a typed two-digit year as 00YY (09/15/26
+    // became 0026-09-15), which sorts before CUTOFF. Read it as 20YY up to
+    // two years ahead, otherwise 19YY.
+    const pivot = (new Date().getFullYear() + 2) % 100;
+    return v.map((l) =>
+      typeof l?.disbursementDate === "string" &&
+      /^00\d\d-/.test(l.disbursementDate)
+        ? {
+            ...l,
+            disbursementDate:
+              (Number(l.disbursementDate.slice(2, 4)) <= pivot ? "20" : "19") +
+              l.disbursementDate.slice(2),
+          }
+        : l
+    );
   },
   save: (loans: Loan[]) => write(LOANS_KEY, loans),
 };
