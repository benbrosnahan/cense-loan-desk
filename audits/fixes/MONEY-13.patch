+/**
+ * True unless a listed loan was paid out before July 1, 2014. A loan from
+ * then that is still owed means the borrower is not a "new borrower" for IBR
+ * under 34 CFR 685.209(b)(13)(ii): IBR then charges 15% of discretionary
+ * income under (f)(3)(i) and forgives after 300 payments under (k)(1).
+ */
+export function isIbrNewBorrower(loans: Loan[]): boolean {
+  return !loans.some(
+    (l) => !!l.disbursementDate && l.disbursementDate < "2014-07-01"
+  );
+}
