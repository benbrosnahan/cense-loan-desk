@@ -0,0 +1,120 @@
+// Cense Loan Desk — backup file. Created with Claude Code.
+//
+// The browser can drop this site's storage on its own (Safari after a spell
+// away, cleared site data, a new phone), and retyping cannot bring back a
+// dated record. A backup file is the copy the borrower keeps. It is written
+// and read on the device and never sent anywhere.
+
+import {
+  DEFAULT_PROFILE,
+  EMPLOYMENT_LABELS,
+  GOAL_LABELS,
+  LOAN_KIND_LABELS,
+  Loan,
+  Profile,
+  Snapshot,
+} from "@/types";
+import { PLAN_META } from "@/data/plans";
+
+const FORMAT = "cense-loan-desk-backup";
+
+export interface Backup {
+  loans: Loan[];
+  profile: Profile;
+  snapshots: Snapshot[];
+}
+
+type Obj = Record<string, unknown>;
+
+const obj = (v: unknown): v is Obj =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+const str = (v: unknown): v is string => typeof v === "string";
+const num = (v: unknown): v is number =>
+  typeof v === "number" && Number.isFinite(v) && v >= 0;
+/** Own keys only, so inherited names such as "constructor" never pass. */
+const oneOf = <K extends string>(v: unknown, options: Record<K, unknown>): v is K =>
+  str(v) && Object.keys(options).includes(v);
+
+// Everything the loan form can store, and nothing that would break a section
+// or skew a total.
+const isLoan = (l: unknown): l is Loan =>
+  obj(l) &&
+  str(l.id) &&
+  l.id !== "" &&
+  str(l.nickname) &&
+  str(l.servicer) &&
+  oneOf(l.kind, LOAN_KIND_LABELS) &&
+  (l.subsidy === "subsidized" || l.subsidy === "unsubsidized") &&
+  num(l.principal) &&
+  num(l.balance) &&
+  l.balance > 0 &&
+  num(l.rate) &&
+  l.rate <= 25 &&
+  num(l.minPayment) &&
+  str(l.disbursementDate) &&
+  // The date input can store a five- or six-digit year.
+  /^\d{4,6}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/.test(l.disbursementDate);
+
+const isSnapshot = (s: unknown): s is Snapshot =>
+  obj(s) &&
+  str(s.takenAt) &&
+  !Number.isNaN(Date.parse(s.takenAt)) &&
+  Array.isArray(s.loans) &&
+  s.loans.every(isLoan) &&
+  num(s.totalBalance);
+
+function readProfile(v: unknown): Profile | null {
+  // Missing answers fall back to the defaults, as profileStore.load() does.
+  const p: Obj = { ...DEFAULT_PROFILE, ...(obj(v) ? v : {}) };
+  const { income, householdSize, employment, goal, extraPerMonth } = p;
+  const plan = p.selectedPlan;
+  if (
+    !num(income) ||
+    !num(extraPerMonth) ||
+    !num(householdSize) ||
+    !Number.isInteger(householdSize) ||
+    householdSize < 1 ||
+    householdSize > 8 ||
+    !oneOf(employment, EMPLOYMENT_LABELS) ||
+    !oneOf(goal, GOAL_LABELS) ||
+    !(plan === null || oneOf(plan, PLAN_META))
+  ) {
+    return null;
+  }
+  return {
+    income,
+    householdSize,
+    employment,
+    goal,
+    extraPerMonth,
+    selectedPlan: plan,
+  };
+}
+
+/** The file's text: everything this page stores, and nothing else. */
+export const backupText = (b: Backup) =>
+  JSON.stringify(
+    { format: FORMAT, version: 1, savedAt: new Date().toISOString(), ...b },
+    null,
+    2
+  );
+
+/**
+ * Null when the text is not a usable backup. All of it is checked before any
+ * of it is used, so a bad file changes nothing.
+ */
+export function parseBackup(text: string): Backup | null {
+  let d: unknown;
+  try {
+    d = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  if (!obj(d) || d.format !== FORMAT || d.version !== 1) return null;
+  const { loans, snapshots } = d;
+  if (!Array.isArray(loans) || !loans.every(isLoan)) return null;
+  if (new Set(loans.map((l) => l.id)).size !== loans.length) return null;
+  if (!Array.isArray(snapshots) || !snapshots.every(isSnapshot)) return null;
+  const profile = readProfile(d.profile);
+  return profile ? { loans, profile, snapshots } : null;
+}
