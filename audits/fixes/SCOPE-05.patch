+/**
+ * Plans that can repay a loan in default. 34 CFR 685.209(c)(1) keeps defaulted
+ * loans out of every income-driven plan except IBR ((d)(2)) and RAP ((d)(4)),
+ * and on default the whole balance is due at once (685.211(d)(1)), so there is
+ * no fixed schedule to choose. Rehabilitation (685.211(f)) brings the choice
+ * back. Checked after the permanent closures, so those keep their own reasons.
+ */
+export const IN_DEFAULT_PLANS: PlanId[] = ["ibr", "rap"];
+
+export const IN_DEFAULT_REASON =
+  "Closed while a loan is in default, because the whole balance is due at once (34 CFR 685.211(d)(1)). Rehabilitating the loan reopens it.";
+
+export const IN_DEFAULT_NOTE =
+  "In default the whole balance is due at once, and collection charges are added and taken out of each payment before principal (34 CFR 685.211(a)(1), (d)). To get out of default, rehabilitate the loan with 9 on-time payments within 10 months, starting at your income-driven amount (at least $5 a month, or $10 from July 1, 2027); consolidate it, which counts as a new loan and leaves only RAP and Tiered Standard; or ask whether a $0 income-driven payment covers the date you defaulted. Rehabilitation brings back the choice of plan. Loans that are not in default can stay on a plan of their own: remove the Default Resolution Group loans to see their figures.";
+
+/**
+ * IN_DEFAULT_NOTE for a Parent PLUS loan in default. A consolidation loan made
+ * now that repays a Parent PLUS loan can never use RAP (685.209(b)(6)(i),
+ * (d)(4), and the 91 FR 23768 preamble quoted above PARENT_PLUS_EXCLUDED_PLANS)
+ * and is too new for IBR ((d)(5)); it gets Tiered Standard, plus ICR until
+ * June 30, 2028 ((c)(5)(iii)(A)). No income-driven plan can hold the Parent
+ * PLUS loan itself, so the $0 income-driven route does not apply.
+ */
+export const IN_DEFAULT_PARENT_PLUS_NOTE =
+  "In default the whole balance is due at once, and collection charges are added and taken out of each payment before principal (34 CFR 685.211(a)(1), (d)). To get out of default, rehabilitate the loan with 9 on-time payments within 10 months, starting at an amount set from your income (at least $5 a month, or $10 from July 1, 2027), or consolidate it. Consolidating a Parent PLUS loan now makes a new loan that can never use RAP: it gets Tiered Standard, plus ICR until June 30, 2028. Rehabilitation brings back the choice of plan. Loans that are not in default can stay on a plan of their own: remove the Default Resolution Group loans to see their figures.";
+
 export const PARENT_PLUS_INELIGIBLE_REASON =
   "Not open to Parent PLUS loans (34 CFR 685.209(d))";
 
