@@ -623,6 +623,78 @@ console.log("\n[17] Parent PLUS eligibility — 685.209(d)(2), (d)(4), 685.210(a
      direct === "extended,graduated,ibr,rap,standard", direct);
 }
 
+// ============================================================ default
+console.log("\n[18] Loans in default — 685.209(c)(1), (d)(2), (d)(4), 685.211(d)(1)");
+{
+  const DRG = "Default Resolution Group";
+  const L = (kind, bal, date, servicer = DRG) => ({ id: kind + date + bal, nickname: kind,
+    servicer, kind, subsidy: kind === "direct_sub" ? "subsidized" : "unsubsidized",
+    principal: bal, balance: bal, rate: 6.53, disbursementDate: date, minPayment: 0 });
+  const prof = { income: 52000, householdSize: 1, employment: "private",
+    goal: "lowest_payment", extraPerMonth: 0, selectedPlan: null };
+  const run = (loans, p = prof) => calc.estimatePlans(calc.buildContext(loans, p));
+  const open = (loans) => run(loans).filter((e) => e.eligible).map((e) => e.id).sort().join(",");
+
+  // Only IBR and RAP repay a defaulted loan; IBR also needs every loan to
+  // predate July 1, 2026 (685.209(d)(5)); neither takes Parent PLUS.
+  ok("legacy Direct loans in default: IBR and RAP only",
+     open([L("direct_sub", 20000, "2022-08-15"), L("direct_unsub", 15000, "2023-08-15")]) === "ibr,rap");
+  ok("a loan from July 2026 on, in default: RAP only",
+     open([L("direct_unsub", 20000, "2022-08-15"), L("direct_unsub", 5000, "2026-08-15")]) === "rap");
+  ok("Parent PLUS in default: no plan open", open([L("parent_plus", 40000, "2023-08-15")]) === "");
+  // A consolidation made now that repays a Parent PLUS loan never gets RAP
+  // (685.209(b)(6)(i), (d)(4)), so its borrowers get their own note.
+  const ppDefault = calc.anyParentPlusInDefault([L("parent_plus", 40000, "2023-08-15")]);
+  const ownDefault = calc.anyParentPlusInDefault([L("parent_plus", 40000, "2023-08-15", "Nelnet"),
+                                                  L("direct_unsub", 9000, "2023-08-15")]);
+  ok("Parent PLUS in default gets the note that never offers RAP",
+     ppDefault && !ownDefault && !/RAP and Tiered Standard/.test(plans.IN_DEFAULT_PARENT_PLUS_NOTE),
+     JSON.stringify({ ppDefault, ownDefault }));
+  // Permanent closures keep their own reason: Extended under $30,000, and
+  // Tiered Standard on a portfolio that is all older loans.
+  const small = run([L("direct_unsub", 12000, "2023-08-15")]);
+  const ext = small.find((e) => e.id === "extended");
+  ok("Extended under $30k keeps its floor reason in default",
+     !ext.eligible && ext.ineligibleReason !== plans.IN_DEFAULT_REASON, ext.ineligibleReason);
+  const tiered = small.find((e) => e.id === "tiered_standard");
+  ok("Tiered Standard in default does not promise the original Standard plan",
+     !/original Standard plan/.test(tiered.ineligibleReason || ""), tiered.ineligibleReason);
+  // The lowest open payment is an income-driven one, never Graduated.
+  const ctx = calc.buildContext([L("direct_unsub", 28000, "2021-08-15")], prof);
+  const pick = calc.rankPlans(calc.estimatePlans(ctx), ctx).ranked.find((r) => r.isTopPick);
+  ok("lowest-payment pick in default is IBR or RAP", ["ibr", "rap"].includes(pick?.estimate.id),
+     pick?.estimate.id);
+
+  // Sweep: default only closes plans. Each plan still open matches the same
+  // loans at another servicer, and the default reason sits only on plans that
+  // would otherwise be open.
+  let bad = [];
+  let seed = 7;
+  const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
+  const kinds = ["direct_sub", "direct_unsub", "grad_plus", "parent_plus"];
+  for (let t = 0; t < 300; t++) {
+    const n = 1 + Math.floor(rnd() * 4);
+    const post = rnd() < 0.3;
+    const spec = Array.from({ length: n }, (_, i) => [kinds[Math.floor(rnd() * 4)],
+      Math.round(500 + rnd() * 40000), post && i === 0 ? "2026-09-01" : "2019-09-01"]);
+    const p = { ...prof, income: Math.round(rnd() * 120000), householdSize: 1 + Math.floor(rnd() * 4),
+      goal: ["lowest_payment", "least_total", "forgiveness", "unsure"][Math.floor(rnd() * 4)] };
+    const inDefault = run(spec.map(([k, b, d]) => L(k, b, d)), p);
+    const current = run(spec.map(([k, b, d]) => L(k, b, d, "Nelnet")), p);
+    for (const e of inDefault) {
+      const c = current.find((x) => x.id === e.id);
+      if (e.eligible && !["ibr", "rap"].includes(e.id)) bad.push(`t${t} ${e.id} open in default`);
+      if (e.eligible && e.monthlyPayment !== c.monthlyPayment) bad.push(`t${t} ${e.id} payment changed`);
+      if (e.ineligibleReason === plans.IN_DEFAULT_REASON && !c.eligible)
+        bad.push(`t${t} ${e.id} default reason on a plan closed anyway`);
+      if (!c.eligible && e.ineligibleReason !== c.ineligibleReason && e.id !== "tiered_standard")
+        bad.push(`t${t} ${e.id} lost its own reason`);
+    }
+  }
+  ok("300 randomised defaulted portfolios: only IBR or RAP open, every other reason kept",
+     bad.length === 0, bad.slice(0, 6).join(" | "));
+}
