@@ -66,6 +66,20 @@ body {
   animation: unfold 0.2s ease-out both;
 }
 
+/* Until the app has read this browser's storage, a borrower with saved loans
+   sees the loading bars instead of the server-rendered first-run screen.
+   layout.tsx sets data-returning; page.tsx drops .prerendered and the bars
+   once hydrated. */
+.returning-skeleton {
+  display: none;
+}
+html[data-returning] .prerendered > .returning-skeleton {
+  display: block;
+}
+html[data-returning] .prerendered > :not(.returning-skeleton) {
+  display: none;
+}
+
 /* "Hide amounts" blurs every dollar figure, for checking your loans somewhere
    public or when the total is not what you want to look at today. The text is
    still there for screen readers. */
