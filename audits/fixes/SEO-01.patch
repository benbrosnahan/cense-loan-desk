 import type { Metadata, Viewport } from "next";
 import { Bricolage_Grotesque, Instrument_Sans } from "next/font/google";
+import { LOANS_KEY } from "@/lib/storage";
 import "./globals.css";
 
+// Runs before first paint. The server HTML is the first-run screen; in a
+// browser with saved loans this marks <html> so globals.css shows the loading
+// bars instead, and the first-run screen never flashes before the borrower's
+// own loans. Only a non-empty array counts, as in loanStore.load(). It only
+// reads, sends nothing, and the function scope keeps the loans off window.
+const RETURNING_SCRIPT =
+  "(function(){try{" +
+  `var v=JSON.parse(localStorage.getItem(${JSON.stringify(LOANS_KEY)}));` +
+  'if(Array.isArray(v)&&v.length)document.documentElement.setAttribute("data-returning","")' +
+  "}catch(e){}})()";
+
 // Two faces, shared with Decode so the Cense tools read as one family.
 // Bricolage carries headlines and headline figures. Instrument Sans carries
 // everything that gets read or compared, and has true tabular figures.
